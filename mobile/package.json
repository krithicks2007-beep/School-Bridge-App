{
  "name": "school-bridge-app",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --lan",
    "dev": "expo start --web",
    "laptop": "set EXPO_HOME=.expo-home&& expo start --web --port 19006",
    "mobile": "expo start --lan",
    "start:phone": "set REACT_NATIVE_PACKAGER_HOSTNAME=10.28.203.243&& expo start --lan",
    "start:tunnel": "expo start --tunnel",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "npx expo export -p web && node fix-index.js"
  },
  "dependencies": {
    "@babel/core": "^7.24.0",
    "@expo/config-plugins": "^57.0.10",
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-picker/picker": "2.11.4",
    "@supabase/supabase-js": "^2.108.2",
    "babel-plugin-transform-import-meta": "^2.2.1",
    "babel-preset-expo": "~57.0.0",
    "expo": "~57.0.0",
    "expo-constants": "~57.0.21",
    "expo-device": "~57.0.2",
    "expo-document-picker": "~57.0.3",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.12",
    "expo-notifications": "~57.0.22",
    "expo-router": "~57.0.25",
    "expo-status-bar": "~57.0.1",
    "nativewind": "^4.2.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-css-interop": "^0.2.5",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "react-refresh": "^0.19.0",
